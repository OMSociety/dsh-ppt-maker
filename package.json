{
  "name": "dsh-ppt-maker",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek Harness plugin that bundles the ppt-maker skill and the PPT tool surface: create, inspect, edit, undo and redo a PPTD v3 project that exports to a locally generated .pptx.",
  "author": "OMSociety (https://github.com/OMSociety)",
  "homepage": "https://github.com/OMSociety/dsh-ppt-maker#readme",
  "bugs": "https://github.com/OMSociety/dsh-ppt-maker/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMSociety/dsh-ppt-maker.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ppt",
    "pptx",
    "pptd",
    "slides",
    "presentation",
    "skill"
  ],
  "main": "./plugin/index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./plugin/index.mjs",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "icon.svg",
    "lib",
    "locale/*.json",
    "plugin",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@office-kit/pptx": "0.24.0",
    "@xmldom/xmldom": "^0.9.8",
    "fflate": "^0.8.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/clean-pycache.mjs"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
