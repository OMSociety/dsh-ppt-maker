{
  "name": "dsh-ppt-maker",
  "version": "2.0.0",
  "type": "module",
  "description": "DSH PPT Maker: AI PowerPoint deck maker for DeepSeek Harness. Create, redesign and edit PPT/PPTX slides and presentations with twelve ppt_* tools, 30 built-in design systems, a right-sidebar visual editor, native charts and tables, import of existing .pptx files, and export to editable PPTX and PDF.",
  "author": "OMSociety (https://github.com/OMSociety)",
  "homepage": "https://github.com/OMSociety/dsh-ppt-maker#readme",
  "bugs": "https://github.com/OMSociety/dsh-ppt-maker/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMSociety/dsh-ppt-maker.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ppt",
    "pptx",
    "powerpoint",
    "slides",
    "presentation",
    "slide-deck",
    "ai-ppt",
    "ppt-generator",
    "pptd",
    "skill"
  ],
  "main": "./plugin/index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "icon.svg",
    "lib",
    "docs/pptd-spec.md",
    "locale/*.json",
    "plugin",
    "scripts/prepare-vendor-env.mjs",
    "skills",
    "!skills/ppt-maker/tests",
    "cordis.patch.yml",
    "README.md",
    "README_en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-native-command": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-native-command": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/libreoffice-kit": "0.2.3",
    "@office-kit/pptx": "0.30.0",
    "@office-kit/pptx-preview": "0.23.0",
    "@xmldom/xmldom": "^0.9.8",
    "fflate": "^0.8.3",
    "fontkit": "2.0.4",
    "subset-font": "2.9.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "happy-dom": "^21.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:mounts": "node scripts/check-mounts.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "prepack": "node scripts/clean-pycache.mjs",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "*"
  },
  "allowScripts": {
    "esbuild": true,
    "koffi": false
  },
  "overrides": {
    "@deepseek-ai/libreoffice-kit": {
      "fflate": "^0.8.3"
    }
  }
}
