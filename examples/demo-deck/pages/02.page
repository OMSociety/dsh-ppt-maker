      color: "#ede6d6"
  - elementId: big-number
    elementType: text
    bounds: [28, 78, 262, 298]
    content:
      text: "12"
      fontFamily: Noto Sans SC
      fontSize: 180
      bold: true
      color: "#d0021b"
  - elementId: panel-title
    elementType: text
    bounds: [40, 300, 250, 38]
    content:
      text: 个 ppt_* 工具
      fontFamily: Noto Sans SC
      fontSize: 22
      bold: true
      color: "#ede6d6"
  - elementId: panel-sub
    elementType: text
    bounds: [40, 342, 250, 26]
    content:
      text: 创作 7　质量 3　交付 2
      fontFamily: Noto Sans SC
      fontSize: 13
